# Contacto (Resend)
# API key desde https://resend.com/api-keys
RESEND_API_KEY=
# Remitente. Mientras no verifiques un dominio propio usá:
# "TAKI3D Web <onboarding@resend.dev>"
RESEND_FROM=TAKI3D Web <onboarding@resend.dev>
# Destino de los mensajes del formulario de contacto
CONTACT_EMAIL=taki3duy@gmail.com
